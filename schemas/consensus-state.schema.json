{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/e2/schemas/consensus-state.schema.json",
  "title": "CON-02 Consensus Iteration State",
  "allOf": [
    { "$ref": "common-envelope.schema.json" },
    {
      "type": "object",
      "required": [
        "message_type",
        "operation_id",
        "iteration",
        "algorithm_id",
        "state",
        "proposed_power_w",
        "imbalance_w"
      ],
      "properties": {
        "message_type": { "const": "CON-02" },
        "iteration": { "type": "integer", "minimum": 0 },
        "algorithm_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "algorithm_version": { "type": "string", "maxLength": 64 },
        "state": {
          "type": "string",
          "enum": ["participating", "converged", "degraded", "withdrawn", "aborted"]
        },
        "lambda_estimate": { "type": ["number", "null"] },
        "proposed_power_w": { "type": "number" },
        "imbalance_w": { "type": "number" },
        "flexibility_up_w": { "type": "number", "minimum": 0 },
        "flexibility_down_w": { "type": "number", "minimum": 0 },
        "local_residual": { "type": ["number", "null"] }
      }
    }
  ]
}

