{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/e2/schemas/common-envelope.schema.json",
  "title": "E2 Common Message Envelope",
  "type": "object",
  "required": ["schema_version", "message_id", "message_type", "source_node_id", "timestamp_utc"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "message_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "group_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "expires_at_utc": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}

